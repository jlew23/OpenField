# Obtain your own keys. Never share a populated .env.
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# ---- OpenField Station (optional; everything can also be set in the Station settings drawer) ----
# Local ComfyUI for free on-GPU character swaps (Wan 2.2 Animate etc.)
COMFYUI_URL=http://127.0.0.1:8188
# Jarvis & personas: local Ollama is auto-detected (also from WSL). Bring-your-own-key options:
OLLAMA_API_BASE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
